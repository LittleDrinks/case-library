{
  "name": "case-library-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:complexity": "eslint --config eslint.config.js src",
    "test": "npm run check:complexity && vitest run",
    "test:watch": "vitest",
    "bddgen": "bddgen -c playwright.config.js",
    "test:e2e": "bddgen -c playwright.config.js && playwright test",
    "test:e2e:bdd": "bddgen -c playwright.config.js && playwright test --project=bdd"
  },
  "dependencies": {
    "@ai-sdk/vue": "3.0.272",
    "@lucide/vue": "^1.31.0",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "ai": "6.0.272",
    "d3-force": "^3.0.0",
    "diff": "^8.0.2",
    "element-plus": "2.14.5",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/test-utils": "^2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "playwright-bdd": "9.2.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
